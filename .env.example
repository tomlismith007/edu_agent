# ===== 教务系统账号 =====
# 注意: 不能叫 USERNAME/PASSWORD，Windows 系统自带 USERNAME 环境变量会覆盖 .env
EDU_USERNAME=
EDU_PASSWORD=

# ===== LLM (OpenAI 兼容 API) =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ===== 服务 =====
PORT=3000

# ===== 缓存 TTL（秒） =====
CACHE_TTL_SCORES=86400
CACHE_TTL_TIMETABLE=21600
CACHE_TTL_TEACHER=21600
CACHE_TTL_CALENDAR=3600
CACHE_TTL_GRADUATION=86400
CACHE_TTL_CREDITS=86400
